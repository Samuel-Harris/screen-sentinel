{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "analytics": false,
  "useDaemonProcess": false,
  "plugins": ["./scripts/nx-cargo-plugin.js"],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/scripts/**/*"
    ],
    "default": ["{projectRoot}/**/*", "!{projectRoot}/**/*.md", "sharedGlobals"],
    "cargo": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/.rustfmt.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/.clippy.toml",
      "{workspaceRoot}/scripts/nx-cargo-plugin.js",
      { "runtime": "node -p \"process.platform+'-'+process.arch\"" },
      { "env": "RUSTFLAGS" },
      { "externalDependencies": [] }
    ]
  },
  "targetDefaults": {
    "build": { "cache": true },
    "test": { "cache": true },
    "lint": { "cache": true },
    "typecheck": { "cache": true },
    "check": [
      {
        "executor": "nx:noop",
        "dependsOn": ["lint", "typecheck", "test", { "projects": ["scripts"], "target": "boundaries" }],
        "inputs": ["default", "^default"]
      },
      { "filter": { "projects": ["tag:lang:rust"] }, "inputs": ["default", "^default", "cargo"] },
      {
        "filter": { "projects": ["screen-sentinel-app"] },
        "inputs": ["default", "^default", "cargo", "{workspaceRoot}/apps/screen-sentinel-app-tauri/lib/utils/tauri.ts"]
      },
      { "filter": { "projects": ["@screen-sentinel/app"] }, "inputs": ["default", "^default", "{workspaceRoot}/biome.json"] }
    ]
  }
}
